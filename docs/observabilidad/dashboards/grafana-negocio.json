{
  "__inputs": [],
  "__requires": [{ "type": "datasource", "id": "prometheus", "name": "DS_PROMETHEUS", "version": "1.0.0" }],
  "title": "MPM Negocio — Licitaciones, Aclaraciones y Scraper",
  "uid": "mpm-negocio-037",
  "tags": ["mpm", "negocio", "037-C"],
  "description": "Dashboard de negocio 037-C: licitaciones ingestadas/día, aclaraciones detectadas, scraper success rate. Fuente: mpm_sync_*, mpm_aclaraciones_*, mpm_scraper_*",
  "timezone": "browser",
  "editable": true,
  "time": { "from": "now-7d", "to": "now" },
  "refresh": "5m",
  "panels": [
    {
      "type": "timeseries",
      "title": "Licitaciones sincronizadas/día por estado",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (estado) (increase(mpm_sync_licitaciones_total[24h]))", "legendFormat": "{{estado}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Aclaraciones detectadas/día por tipo",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (tipo) (increase(mpm_aclaraciones_detectadas_total[24h]))", "legendFormat": "{{tipo}}", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Scraper success rate (24h)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 0.7 }, { "color": "green", "value": 0.95 }] } }, "overrides": [] },
      "targets": [
        { "expr": "sum(increase(mpm_scraper_runs_total{estado=\"success\"}[24h])) / sum(increase(mpm_scraper_runs_total[24h]))", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Scraper runs/día por estado",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (estado) (increase(mpm_scraper_runs_total[24h]))", "legendFormat": "{{estado}}", "refId": "A" }
      ]
    },
    {
      "type": "table",
      "title": "Scraper runs totales (cumulative)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (estado) (mpm_scraper_runs_total)", "format": "table", "refId": "A" }
      ]
    }
  ],
  "templating": {
    "list": [
      { "name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "prometheus" } }
    ]
  }
}
