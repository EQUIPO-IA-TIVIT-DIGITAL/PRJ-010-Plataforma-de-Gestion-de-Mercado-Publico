{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const f=(JSON.parse(d).file_path||'').replace(/\\\\/g,'/');if(f.endsWith('.env')){console.error('Blocked: .env contains secrets — edit it directly in your editor, not through Claude');process.exit(2);}}catch(e){}});\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const f=(JSON.parse(d).file_path||'').replace(/\\\\/g,'/');if(f.includes('mpm-web/src')&&(f.endsWith('.ts')||f.endsWith('.tsx'))){const{execSync}=require('child_process');try{execSync('npx tsc --noEmit',{cwd:'src/mpm-web',stdio:'pipe'});}catch(e){const out=(e.stdout?.toString()||'')+(e.stderr?.toString()||'');console.error('TypeScript errors:\\n'+out);process.exit(1);}}}catch(e){}});\""
          }
        ]
      }
    ]
  }
}
