# ─────────────────────────────────────────────
# MPM — Mercado Público Management
# Copiar como .env y rellenar con valores reales
# ─────────────────────────────────────────────

# ── Base de datos ─────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_USER=mpm
DB_PASSWORD=changeme
DB_NAME=mpm

# ── Redis ─────────────────────────────────────
REDIS_PASSWORD=changeme

# ── JWT ───────────────────────────────────────
JWT_SECRET=CHANGE-THIS-IN-PRODUCTION-MIN-32-CHARS-LONG
JWT_ISSUER=TIVIT.MPM
JWT_AUDIENCE=MPM.Users

# ── Mercado Público API REST ──────────────────
# Ticket de autenticación para la API pública REST (sincronización de licitaciones)
MP_TICKET=

# ── Mercado Público Scraper (credenciales web) ─
# RUT y contraseña para que Playwright navegue la interfaz web de Mercado Público
# Formato RUT: XXXXXXXX-X (sin puntos)
MP_RUT=
MP_PASSWORD=

# ── Configuración del scraper ─────────────────
SCRAPER_ENABLED=false
SCRAPER_INTERVAL_HOURS=12
MP_ANALISIS_IA=true
MP_HEADLESS=true
MP_FECHA_DESDE=01-01-2025
MP_DELAY_MS=1500
MP_MAX_REINTENTOS=3

# ── API interna (usada por el scraper para llamar a la API del MPM) ──
API_BASE_URL=http://localhost:5001

# ── Monitor de aclaraciones ───────────────────
# Detecta nuevas solicitudes de aclaración en licitaciones activas seguidas por usuarios
MONITOR_ENABLED=true
MONITOR_INTERVAL_MINUTES=30

# ── Gemini AI (vía Vertex AI + ADC, 020-migracion-gemini-adc) ─────────────────
# Ya no usa API key. Requiere:
#   1. gcloud auth application-default login   (una vez, con tu cuenta de tivit-cu010)
#   2. ADC_CREDENTIALS_PATH apuntando al archivo generado por ese comando:
#      - Windows: C:/Users/<tu-usuario>/AppData/Roaming/gcloud/application_default_credentials.json
#      - macOS/Linux: /home/<tu-usuario>/.config/gcloud/application_default_credentials.json
GOOGLE_CLOUD_PROJECT=tivit-cu010
VERTEX_REGION=us-central1
ADC_CREDENTIALS_PATH=

# ── Telegram (notificaciones de Alertas, User Story 5 de 003-fase6-alertas-keywords) ──
# Token del bot: hablarle a @BotFather en Telegram -> /newbot -> pegar el token que devuelve.
TELEGRAM_BOT_TOKEN=
# Username del bot sin @ (ej. CU010_bot) -- se usa para armar el deep link t.me/<user>?start=<token>.
TELEGRAM_BOT_USERNAME=CU010_bot
# Secreto arbitrario que se pasa a Telegram al llamar setWebhook (ver runbook de producción).
# Requiere una URL HTTPS publica -- no funciona en localhost. Sin esto configurado, "Mi Telegram"
# sigue funcionando en modo manual (pegar el Chat ID a mano).
TELEGRAM_WEBHOOK_SECRET=

# ── Storage ───────────────────────────────────
# local → archivos en /app/uploads | gcs → Google Cloud Storage
# Storage__Provider=local
# Storage__Bucket=nombre-bucket-gcs

# ── ASP.NET Core ──────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ----- Correo (Brevo SMTP relay, alertas de la spec 024) -----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TIVIT Mercado Público
SMTP_ENABLE_SSL=true

# ----- Extraccion de documentos (016-extraccion-documentos-api) -----
# Modo de extraccion de adjuntos: solo_navegador | http | mixto
EXTRACCION_MODO=solo_navegador
EXTRACCION_SESION_TTL_HORAS=6
EXTRACCION_EXPORTAR_SESION_SCRIPT_PATH=

# ----- CORS (allow-list de origenes, QA BUG-011) -----
# Lista separada por comas de origenes autorizados para la API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8181

