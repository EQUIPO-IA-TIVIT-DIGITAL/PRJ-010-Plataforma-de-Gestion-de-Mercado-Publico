import { test, expect } from '@playwright/test';

test.describe('$ENTITY Module', () => {
  const baseUrl = process.env.BASE_URL ?? 'http://localhost:3000';

  test.beforeEach(async ({ page }) => {
    await page.goto(baseUrl);
  });

  test('should render $entities list page', async ({ page }) => {
    await expect(page.locator('h2')).toContainText('$ENTITIES');
  });

  test('should create a new $entity', async ({ page }) => {
    await page.locator('button:has-text("New $ENTITY")').click();
    await page.locator('button:has-text("Create")').click();
    await expect(page.locator('.ant-table-row')).toBeVisible();
  });

  test('should show empty state when no $entities exist', async ({ page }) => {
    await expect(page.locator('.ant-empty')).toBeVisible();
  });
});
