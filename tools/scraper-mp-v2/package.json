{
  "name": "scraper-mp",
  "version": "2.1.0",
  "description": "Agente automatizado para extraer datos y Actas de Evaluación de licitaciones desde Mercado Publico",
  "main": "agente-mp.js",
  "type": "module",
  "scripts": {
    "start": "node agente-mp.js",
    "agente": "node agente-mp.js",
    "agente:headless": "MP_HEADLESS=true node agente-mp.js",
    "agente:debug": "MP_HEADLESS=false node agente-mp.js",
    "agente:daemon": "node agente-mp.js --daemon",
    "agente:incremental": "node agente-mp.js --incremental",
    "extraer": "node extraer.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.6.1",
    "pg": "^8.13.0",
    "playwright": "^1.50.0"
  }
}
