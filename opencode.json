{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": true,
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres"
      ],
      "enabled": true,
      "env": {
        "POSTGRES_CONNECTION_STRING": "${POSTGRES_CONNECTION_STRING}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "playwright-mcp"
      ],
      "enabled": true
    },
    "observability": {
      "type": "local",
      "command": [
        "PLACEHOLDER_COMMAND"
      ],
      "enabled": false,
      "env": {
        "OBSERVABILITY_API_KEY": "${OBSERVABILITY_API_KEY}"
      }
    },
    "automation-safe": {
      "type": "local",
      "command": [
        "PLACEHOLDER_COMMAND"
      ],
      "enabled": false,
      "env": {
        "AUTOMATION_TOKEN": "${AUTOMATION_TOKEN}"
      }
    }
  },
  "permission": {
    "edit": {
      ".opencode/framework/**": "ask",
      ".opencode/agents/**": "ask",
      "*": "allow"
    },
    "bash": {
      "git *": "allow",
      "rm *": "ask",
      "*": "ask"
    },
    "external_directory": {
      "~/.config/opencode/**": "deny",
      "**/node_modules/**": "deny",
      "*": "allow"
    }
  }
}